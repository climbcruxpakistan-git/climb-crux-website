# Backend API base URL used by `astro dev`, `astro build` and the post-build
# sitemap generator. Copy this file to `.env` and adjust as needed.
#
# `astro dev` defaults to the local backend when this is unset:
#   VITE_API_URL=http://localhost:4000/api
#
# Production builds default to the deployed Render API below:
VITE_API_URL=https://climb-crux-backend.onrender.com/api
