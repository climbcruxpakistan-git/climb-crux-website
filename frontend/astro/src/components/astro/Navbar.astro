---
import NavToggle from '../react/NavToggle.jsx';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
const path = (currentPath || '/').replace(/\/+$/, '') || '/';

const LINKS = [
  { href: '/', label: 'Home' },
  { href: '/sessions', label: 'Public Sessions' },
  { href: '/private-premium', label: 'Private & Premium' },
  { href: '/our-team', label: 'Our Team' },
  { href: '/about', label: 'About' },
  { href: '/gallery', label: 'Gallery' },
];

function isActive(href: string) {
  // Home is only active on the exact home page.
  if (href === '/') return path === '/';
  // Section links stay highlighted on their sub-pages too (e.g. /our-team/[id]).
  return path === href || path.startsWith(href + '/');
}
---

<nav class="navbar" role="navigation">
  <div class="wrap navbar-inner">
    <a href="/" class="navbar-brand" aria-label="Climb Crux home">
      <img src="/logo.png" alt="Climb Crux" width="60" height="60" />
    </a>
    <div id="navbar-links" class="navbar-links">
      {LINKS.map((link) => (
        <a href={link.href} class:list={['navbar-link', { 'is-active': isActive(link.href) }]}>
          {link.label}
        </a>
      ))}
      <a href="/shop" class="btn btn-dark navbar-cta">Shop Now</a>
      <a href="/book-now" class="btn btn-primary navbar-cta">Book Now</a>
    </div>
    <NavToggle client:load />
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--chalk);
    border-bottom: 3px solid var(--orange);
    width: 100%;
    max-width: 100vw;
  }
  @media (max-width: 860px) {
    .navbar { position: relative; }
  }
  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 88px;
    gap: 0;
  }
  @media (max-width: 500px) {
    .navbar-inner { height: 68px; }
  }
  .navbar-brand img {
    height: 60px;
    display: block;
  }
  @media (max-width: 500px) {
    .navbar-brand img { height: 44px; }
  }
  .navbar-links {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .navbar-link {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 0.86rem;
    letter-spacing: 0.05em;
    font-weight: 500;
    color: var(--charcoal);
    padding: 10px 16px;
    border-radius: 6px;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .navbar-link:hover,
  .navbar-link.is-active {
    background: var(--orange);
  }
  .navbar-cta {
    padding: 0.65em 1.4em;
    font-size: 0.82rem;
  }
  @media (min-width: 861px) {
    .navbar-cta + .navbar-cta {
      margin-left: 8px;
    }
  }
  @media (max-width: 860px) {
    .navbar-links {
      position: absolute;
      top: 88px;
      left: 0;
      right: 0;
      background: var(--chalk);
      border-bottom: 3px solid var(--orange);
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }
    .navbar-links.is-open {
      max-height: 640px;
    }
    .navbar-link {
      width: 100%;
      padding: 16px var(--edge);
      border-bottom: 1px solid var(--chalk-dim);
      box-sizing: border-box;
    }
    /* Full-width, equal, edge-aligned CTA buttons — matches the menu links so
       Book Now / Shop Now line up with each other and with the items above. */
    .navbar-cta:nth-last-child(2),
    .navbar-cta:last-child {
      width: calc(100% - (var(--edge) * 2));
      margin: 0 var(--edge);
      justify-content: center;
      text-align: center;
      box-sizing: border-box;
    }
    .navbar-cta:nth-last-child(2) {
      margin-top: 20px;
    }
    .navbar-cta:last-child {
      /* Keep the CTA buttons spaced apart like the menu links above them */
      margin-top: 14px;
      margin-bottom: 20px;
    }
  }
  @media (max-width: 500px) {
    .navbar-links { top: 68px; }
    .navbar-link { padding: 14px var(--edge); font-size: 0.82rem; }
    .navbar-cta,
    .navbar-cta + .navbar-cta { font-size: 0.78rem; }
  }
</style>
