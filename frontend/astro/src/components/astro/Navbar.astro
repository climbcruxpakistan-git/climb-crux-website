---
import NavToggle from '../react/NavToggle.jsx';
---

<nav class="navbar" role="navigation">
  <div class="wrap navbar-inner">
    <a href="/" class="navbar-brand" aria-label="Climb Crux home">
      <img src="/logo.png" alt="Climb Crux" width="60" height="60" />
    </a>
    <div id="navbar-links" class="navbar-links">
      <a href="/sessions" class="navbar-link">Sessions</a>
      <a href="/private-premium" class="navbar-link">Private &amp; Premium</a>
      <a href="/shop" class="navbar-link">Shop</a>
      <a href="/our-team" class="navbar-link">Our Team</a>
      <a href="/gallery" class="navbar-link">Gallery</a>
      <a href="/about" class="navbar-link">About</a>
      <a href="/book-now" class="btn btn-primary navbar-cta">Book Now</a>
    </div>
    <NavToggle client:load />
  </div>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--chalk);
    border-bottom: 3px solid var(--orange);
    width: 100%;
    max-width: 100vw;
  }
  @media (max-width: 860px) {
    .navbar { position: relative; }
  }
  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 88px;
    gap: 0;
  }
  @media (max-width: 500px) {
    .navbar-inner { height: 68px; }
  }
  .navbar-brand img {
    height: 60px;
    display: block;
  }
  @media (max-width: 500px) {
    .navbar-brand img { height: 44px; }
  }
  .navbar-links {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .navbar-link {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 0.86rem;
    letter-spacing: 0.05em;
    font-weight: 500;
    color: var(--charcoal);
    padding: 10px 16px;
    border-radius: 6px;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .navbar-link:hover {
    background: var(--orange);
  }
  .navbar-cta {
    padding: 0.65em 1.4em;
    font-size: 0.82rem;
  }
  @media (max-width: 860px) {
    .navbar-links {
      position: absolute;
      top: 88px;
      left: 0;
      right: 0;
      background: var(--chalk);
      border-bottom: 3px solid var(--orange);
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }
    .navbar-links.is-open {
      max-height: 480px;
    }
    .navbar-link {
      width: 100%;
      padding: 16px var(--edge);
      border-bottom: 1px solid var(--chalk-dim);
    }
    .navbar-cta {
      margin: 16px var(--edge) 20px;
    }
  }
  @media (max-width: 500px) {
    .navbar-links { top: 68px; }
    .navbar-link { padding: 14px var(--edge); font-size: 0.82rem; }
    .navbar-cta { width: calc(100% - calc(var(--edge) * 2)); text-align: center; font-size: 0.78rem; }
  }
</style>
