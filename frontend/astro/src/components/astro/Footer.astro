---
import CliffEdge from './CliffEdge.astro';
import { WHATSAPP_WA_ME, WHATSAPP_DISPLAY } from '../../../../../shared/contact.js';
---

<CliffEdge fill="var(--charcoal-deep)" height={48} />
<footer class="footer">
  <svg class="footer-topo" viewBox="0 0 1440 520" preserveAspectRatio="none" fill="none" stroke="#F36F21" stroke-opacity=".16" stroke-width="1.2" aria-hidden="true">
    <path d="M-50 140C200 60 330 180 560 100S900 -40 1100 20 1400 -80 1500 -40"/>
    <path d="M-50 180C200 100 330 220 560 140S900 0 1100 60 1400 -40 1500 0"/>
    <path d="M-50 220C200 140 330 260 560 180S900 40 1100 100 1400 0 1500 40"/>
    <path d="M-50 260C200 180 330 300 560 220S900 80 1100 140 1400 40 1500 80"/>
    <path d="M-50 300C200 220 330 340 560 260S900 120 1100 180 1400 80 1500 120"/>
    <path d="M-50 340C200 260 330 380 560 300S900 160 1100 220 1400 120 1500 160"/>
  </svg>

  <div class="wrap footer-inner">
    <div class="footer-brand">
      <img src="/logo.png" alt="Climb Crux" class="footer-logo" width="101" height="96" />
      <p>Islamabad's premier rock climbing club.</p>
    </div>

    <div>
      <h4>Climb</h4>
      <ul>
        <li><a href="/sessions/" class="footer-link-primary">Public Sessions</a></li>
        <li><a href="/private-premium/">Private &amp; Premium</a></li>
        <li><a href="/rock-climbing-guide-islamabad/">Climbing Guide</a></li>
        <li><a href="/check-status/">Check Booking Status</a></li>
      </ul>
    </div>

    <div>
      <h4>Explore</h4>
      <ul>
        <li><a href="/our-team/">Our Team</a></li>
        <li><a href="/about/">About</a></li>
        <li><a href="/gallery/">Gallery</a></li>
        <li><a href="/shop/">Shop Climbing Equipment</a></li>
      </ul>
    </div>

    <div>
      <h4>Connect</h4>
      <ul class="footer-contact">
        <li>
          <a href="https://instagram.com/climbcruxpakistan" target="_blank" rel="noreferrer">
            <span class="footer-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="#F36F21" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".6"/></svg>
            </span>
            <span class="footer-contact-text"><small>Instagram</small><strong>@climbcruxpakistan</strong></span>
          </a>
        </li>
        <li>
          <a href={WHATSAPP_WA_ME} target="_blank" rel="noreferrer">
            <span class="footer-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="#F36F21" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l1.3-4.2A8 8 0 1 1 8.4 18.8z"/><path d="M9 9.5c.3 2.2 2.5 4.4 5 5l1.4-1.2-1.8-1-.8.6c-.9-.4-1.6-1.1-2-2l.6-.8-1-1.8z"/></svg>
            </span>
            <span class="footer-contact-text"><small>WhatsApp</small><strong>{WHATSAPP_DISPLAY}</strong></span>
          </a>
        </li>
        <li>
          <a href="mailto:climbcruxpakistan@gmail.com">
            <span class="footer-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="#F36F21" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="2.5"/><path d="M3.5 7.5l8.5 6 8.5-6"/></svg>
            </span>
            <span class="footer-contact-text"><small>Email</small><strong>climbcruxpakistan@gmail.com</strong></span>
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h4>Legal</h4>
      <ul>
        <li><a href="/terms-and-conditions/">Terms &amp; Conditions</a></li>
        <li><a href="/return-refund-policy/">Return &amp; Refund Policy</a></li>
        <li><a href="/privacy-policy/">Privacy Policy</a></li>
        <li><a href="/shipping-policy/">Shipping Policy</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-inner wrap">
      <span>&copy; {new Date().getFullYear()} Climb Crux Pakistan. All rights reserved.</span>
      <span>Islamabad, Pakistan</span>
    </div>
  </div>
</footer>

