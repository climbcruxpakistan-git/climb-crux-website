---
// Thin, continuously moving announcement strip shown only on shopping pages.
// Included once per shop route via this shared component — no duplicated markup.
const ANNOUNCEMENT =
  'FREE SHIPPING on orders above PKR 10,000 • Shipping charges up to PKR 1,000 • Shipping available nationwide';
const COPIES = 6;
---

<div class="sa-bar">
  <div class="sa-track" aria-hidden="true">
    {
      [...Array(COPIES)].map((_, i) => (
        <span class="sa-group">
          <span class="sa-item">
            FREE SHIPPING on orders above PKR 10,000 <span class="sa-bullet">•</span>{' '}
            Shipping charges up to PKR 1,000{' '}
            <span class="sa-bullet">•</span> Shipping available nationwide
          </span>
        </span>
      ))
    }
  </div>
  <span class="sa-sr">{ANNOUNCEMENT}</span>
</div>

<style>
  .sa-bar {
    display: block;
    background: var(--charcoal-deep);
    width: 100%;
    max-width: 100vw;
    overflow: hidden;
    border-bottom: 2px solid var(--orange);
  }
  .sa-track {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    will-change: transform;
    animation: sa-scroll 36s linear infinite;
  }
  .sa-group {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .sa-item {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.09em;
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1;
    color: var(--chalk);
    padding: 11px 0;
    white-space: nowrap;
  }
  .sa-bullet {
    color: var(--orange-light);
    padding: 0 0.5em;
  }
  .sa-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
    padding: 0;
  }
  @keyframes sa-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-16.6667%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sa-track {
      animation: none !important;
      width: 100%;
      justify-content: center;
    }
    .sa-group {
      display: none;
    }
    .sa-group:first-child {
      display: inline-flex;
    }
  }
</style>