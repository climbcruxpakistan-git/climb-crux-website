---
import Navbar from '../components/astro/Navbar.astro';
import Footer from '../components/astro/Footer.astro';
import { ViewTransitions } from 'astro:transitions';
import '../styles/index.css';
import '../styles/layout.css';
import '../styles/shared.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#383839" />
    <ViewTransitions />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" href="/logo.png" sizes="any" />
    <link rel="canonical" href="https://www.climbcruxpakistan.com{Astro.url.pathname}" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="keywords" content="rock climbing in Islamabad, adventure in Islamabad, rock climbing club Islamabad, events in Islamabad, hiking in Islamabad, rock climbing Margalla Hills, adventure activities Islamabad, outdoor activities Islamabad, climbing club Pakistan, hiking trails Islamabad, Islamabad adventure club, guided climbing Islamabad" />
    <!-- Local SEO: Islamabad / Margalla Hills geo tags -->
    <meta name="geo.region" content="PK-IS" />
    <meta name="geo.placename" content="Islamabad, Margalla Hills, Pakistan" />
    <meta name="geo.position" content="33.7448;73.0660" />
    <meta name="ICBM" content="33.7448, 73.0660" />
    <!-- Open Graph / Twitter -->
    <meta property="og:site_name" content="Climb Crux Pakistan" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_PK" />
    <meta property="og:title" content="Climb Crux Pakistan — Rock Climbing & Adventure in Islamabad" />
    <meta property="og:description" content="Climb Crux is Islamabad's premier rock climbing club, offering professionally guided rock climbing sessions, expert coaching, monthly memberships and a supportive community for beginners and experienced climbers." />
    <meta property="og:url" content="https://www.climbcruxpakistan.com" />
    <meta property="og:image" content="https://www.climbcruxpakistan.com/logo.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Climb Crux Pakistan — Rock Climbing & Adventure in Islamabad" />
    <meta name="twitter:description" content="Climb Crux is Islamabad's premier rock climbing club, offering professionally guided rock climbing sessions, expert coaching, monthly memberships and a supportive community for beginners and experienced climbers." />
    <!-- LocalBusiness structured data for local search (Islamabad) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SportsActivityLocation',
      'name': 'Climb Crux Pakistan',
      'alternateName': 'Climb Crux — Rock Climbing Club Islamabad',
      'description': 'Guided rock climbing and adventure club in Islamabad. Public rock climbing sessions, private coaching, premium ascents, hiking and adventure events on Margalla Hills.',
      'url': 'https://www.climbcruxpakistan.com/',
      'telephone': '+92 313 2690377',
      'email': 'climbcruxpakistan@gmail.com',
      'priceRange': 'PKR 2,500 - PKR 30,000',
      'image': 'https://www.climbcruxpakistan.com/logo.png',
      'address': {
        '@type': 'PostalAddress',
        'addressLocality': 'Islamabad',
        'addressRegion': 'Islamabad Capital Territory',
        'addressCountry': 'PK',
      },
      'geo': {
        '@type': 'GeoCoordinates',
        'latitude': 33.7448,
        'longitude': 73.0660,
      },
      'hasMap': 'https://www.google.com/maps/search/?api=1&query=Margalla+Hills+National+Park+Islamabad',
      'areaServed': [
        { '@type': 'City', 'name': 'Islamabad' },
        { '@type': 'City', 'name': 'Rawalpindi' },
        { '@type': 'Place', 'name': 'Margalla Hills' },
      ],
      'sport': ['Rock Climbing', 'Hiking', 'Adventure Sports'],
      'knowsAbout': ['Rock Climbing', 'Climbing Instruction', 'Outdoor Adventure', 'Margalla Hills', 'Adventure Sports'],
      'keywords': 'rock climbing in Islamabad, rock climbing club Islamabad, Margalla Hills climbing, adventure Islamabad, climbing club Pakistan',
      'sameAs': [
        'https://instagram.com/climbcrux',
        'https://facebook.com/climbcrux',
      ],
      'openingHours': 'Sa 07:00-13:00, Su 07:00-13:00',
      'openingHoursSpecification': [
        {
          '@type': 'OpeningHoursSpecification',
          'dayOfWeek': ['Saturday', 'Sunday'],
          'opens': '07:00',
          'closes': '13:00',
        },
      ],
    })} />
    <!-- WebSite structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      'name': 'Climb Crux Pakistan',
      'alternateName': 'Rock Climbing Club Islamabad',
      'url': 'https://www.climbcruxpakistan.com/',
      'inLanguage': 'en-PK',
      'publisher': {
        '@type': 'Organization',
        'name': 'Climb Crux Pakistan',
        'url': 'https://www.climbcruxpakistan.com/',
        'logo': 'https://www.climbcruxpakistan.com/logo.png',
        'sameAs': [
          'https://instagram.com/climbcrux',
          'https://facebook.com/climbcrux',
        ],
      },
    })} />
    <!-- Organization structured data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      'name': 'Climb Crux Pakistan',
      'alternateName': 'Climb Crux — Rock Climbing Club Islamabad',
      'url': 'https://www.climbcruxpakistan.com/',
      'logo': 'https://www.climbcruxpakistan.com/logo.png',
      'email': 'climbcruxpakistan@gmail.com',
      'telephone': '+92 313 2690377',
      'sameAs': [
        'https://instagram.com/climbcrux',
        'https://facebook.com/climbcrux',
      ],
      'contactPoint': {
        '@type': 'ContactPoint',
        'telephone': '+92 313 2690377',
        'contactType': 'customer service',
        'email': 'climbcruxpakistan@gmail.com',
        'availableLanguage': ['English', 'Urdu'],
        'areaServed': 'PK',
      },
    })} />
    <!-- Google tag (gtag.js) - GA4 -->
    {
      import.meta.env.PROD && (
        <>
          <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-QTTHTK67QR"></script>
          <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', 'G-QTTHTK67QR');

            // Re-trigger page views during Astro View Transitions
            document.addEventListener('astro:after-swap', () => {
              gtag('js', new Date());
              gtag('config', 'G-QTTHTK67QR');
            });
          </script>
        </>
      )
    }

    <slot name="head" />
  </head>
  <body>
    <Navbar currentPath={Astro.url.pathname} />
    <main class="page-fade-in">
      <slot />
    </main>
    <Footer />
  </body>
</html>
