---
import MainLayout from '../layouts/MainLayout.astro';
import RouteExplorer from '../components/react/RouteExplorer.jsx';
import { AREAS, AVAILABLE_GRADES, flattenRoutes, sortRoutesByGrade, TOTAL_ROUTES } from '../data/margallaRoutes';
import { slugify } from '../lib/slug.js';
import '../styles/RockClimbingGuide.css';

const SITE_URL = 'https://www.climbcruxpakistan.com';
const allRoutes = flattenRoutes();

const explorerAreas = AREAS.map((area) => ({
  id: area.id,
  name: area.name,
  venues: area.venues.map((venue) => ({ id: venue.id, name: venue.name })),
}));

// Routes in the same order they render in the library, so the structured data
// and the visible list can never drift apart.
const routesByGrade = sortRoutesByGrade(allRoutes);
const gradeRange = `${AVAILABLE_GRADES[0]}–${AVAILABLE_GRADES[AVAILABLE_GRADES.length - 1]}`;

// ItemList: tells Google this page is the directory of every documented route,
// each deep-linked to its own anchor in the library.
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${SITE_URL}/routes/#route-list`,
  name: 'Rock climbing routes in Islamabad and the Margalla Hills',
  numberOfItems: routesByGrade.length,
  itemListElement: routesByGrade.map((route, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: route.name,
    url: `${SITE_URL}/routes/${slugify(route.name)}/`,
  })),
};

const collectionPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Rock Climbing Routes in Islamabad',
  description: `A filterable directory of every documented rock climbing route in Islamabad and the Margalla Hills, graded from ${gradeRange}.`,
  url: `${SITE_URL}/routes/`,
  isPartOf: { '@type': 'WebSite', name: 'Climb Crux Pakistan', url: `${SITE_URL}/` },
  about: {
    '@type': 'Place',
    name: 'Margalla Hills',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Islamabad',
      addressRegion: 'Islamabad Capital Territory',
      addressCountry: 'PK',
    },
  },
  mainEntity: { '@id': `${SITE_URL}/routes/#route-list` },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Rock Climbing Routes', item: `${SITE_URL}/routes/` },
  ],
};

const totalVenues = AREAS.reduce((n, area) => n + area.venues.length, 0);
const statChips = [
  { k: String(AREAS.length), v: 'Climbing areas' },
  { k: String(totalVenues), v: 'Venues' },
  { k: String(TOTAL_ROUTES), v: 'Named routes' },
];
---

<MainLayout
  title={`Rock Climbing Routes in Islamabad | ${TOTAL_ROUTES} Margalla Hills Routes | Climb Crux`}
  description={`Explore ${TOTAL_ROUTES} rock climbing routes in Islamabad and the Margalla Hills. Filter the route library by grade (${gradeRange}), climbing area, venue or route name.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(collectionPageJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>
  <section class="page-header route-library-header">
    <div class="page-header-pattern"></div>
    <div class="page-header-accent"></div>
    <div class="wrap page-header-inner guide-hero-inner">
      <h1>Rock Climbing Routes in Islamabad</h1>
      <div class="page-header-desc">
        <p>
          Browse the complete Margalla Hills route library — every documented rock climbing route
          in Islamabad, from beginner-friendly slabs to the hardest lines on the hills. Search by
          route name, or filter by grade ({gradeRange}), climbing area or venue. Every filtered view
          is kept in the URL, so it can be shared or bookmarked.
        </p>
      </div>
      <div class="guide-stats" role="list">
        {statChips.map((chip) => (
          <div class="guide-stat" role="listitem">
            <b>{chip.k}</b>
            <span>{chip.v}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="route-explorer" class="section">
    <div class="wrap">
      {/* Full mode: search + climbing area + grade range + venue, with the
          filter state mirrored into the URL so views can be shared. */}
      <RouteExplorer client:load mode="full" routes={allRoutes} areas={explorerAreas} />
      <p class="route-library-note">
        New to the crags? <a href="/rock-climbing-guide-islamabad">Explore the full guide to climbing in the Margalla Hills</a>,
        then <a href="/sessions">book a guided rock climbing session</a> and climb these routes with Climb Crux.
      </p>
    </div>
  </section>
</MainLayout>

<style>
  .route-library-header h1 {
    font-size: clamp(2.4rem, 5.4vw, 4rem);
    max-width: 20ch;
    margin-bottom: 0.55em;
  }

  .route-library-header .guide-stats {
    margin-top: 8px;
  }

  /* Stat chips: solid orange with black text. */
  .route-library-header .guide-stat {
    background: var(--orange);
    border-color: var(--orange-dark);
    border-left-color: var(--orange-dark);
  }

  .route-library-header .guide-stat b,
  .route-library-header .guide-stat span {
    color: var(--charcoal-deep);
  }

  /* Contextual links to the guide and sessions, below the library. */
  .route-library-note {
    margin-top: 26px;
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--stone-dark);
  }

  .route-library-note a {
    color: var(--orange-dark);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .route-library-note a:hover {
    color: var(--charcoal);
  }
</style>