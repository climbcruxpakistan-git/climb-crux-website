---
import MainLayout from '../layouts/MainLayout.astro';
import RouteExplorer from '../components/react/RouteExplorer.jsx';
import GradeChart from '../components/react/GradeChart.jsx';
import { optimizeImage } from '../lib/api';
import {
  AREAS,
  MARGALLA_SOURCE,
  AVAILABLE_GRADES,
  flattenRoutes,
  sortRoutesByGrade,
  TOTAL_ROUTES,
} from '../data/margallaRoutes';
import {
  ROUTE_LIBRARY_BASE,
  ROUTE_PARAMS,
} from '../lib/routeFilters';
import '../styles/RockClimbingGuide.css';
import { slugify } from '../lib/slug';

/**
 * Rock Climbing Guide Islamabad — a static SEO / resource page for climbing in
 * Islamabad and the Margalla Hills.
 *
 * Content rules this page follows:
 *  · Current Climb Crux information comes from the live session system, or is
 *    described as a Climb Crux offering (public / private sessions).
 *  · Route names, grades and descriptions taken from "Monkey Business — A
 *    Guide to Climbing in Margalla" (John Arran, February 2011) are always
 *    labelled as historical, never presented as current.
 *  · Anything that can change (access, meeting points, conditions, grades,
 *    equipment availability) is written cautiously and deferred to the live
 *    booking system.
 */

// Existing Climb Crux hero photograph — the same verified Cloudinary asset used
// by the home-page hero (see backend/src/models/HomeContent.js). Not invented.
// Kept here only as the page's social share (og:image) preview.
const HERO_IMAGE_SOURCE = 'https://res.cloudinary.com/ivvx77mg/image/upload/v1785872185/climb-crux/eswc8bon6d6ognvow4mj.jpg';
const heroImage = optimizeImage(HERO_IMAGE_SOURCE, 1400);
// Same verified Cloudinary asset as the homepage hero, at hero-background size.
const heroBgImage = optimizeImage(HERO_IMAGE_SOURCE, 1600);

/* ── Route data ───────────────────────────────────────────────────── */
const SITE_URL = 'https://www.climbcruxpakistan.com';
const GUIDE_URL = `${SITE_URL}/rock-climbing-guide-islamabad/`;

const allRoutes = flattenRoutes();

// ItemList: tells Google this page is the directory of every documented route,
// each deep-linked to its own route page.
const routesByGrade = sortRoutesByGrade(allRoutes);

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${GUIDE_URL}#route-list`,
  name: 'Rock climbing routes in Islamabad and the Margalla Hills',
  numberOfItems: routesByGrade.length,
  itemListElement: routesByGrade.map((route, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: route.name,
    url: `${SITE_URL}${ROUTE_LIBRARY_BASE}${slugify(route.name)}/`,
  })),
};

const chartData = AVAILABLE_GRADES.map((g) => ({ grade: g, count: allRoutes.filter((r) => r.grade === g).length }));

// Shape the areas into what the explorer expects (id, name, venues) — the same
// data the route library passes to its full-mode explorer.
const explorerAreas = AREAS.map((area) => ({
  id: area.id,
  name: area.name,
  venues: area.venues.map((venue) => ({ id: venue.id, name: venue.name })),
}));

const totalVenues = AREAS.reduce((n, area) => n + area.venues.length, 0);

/* ── FAQ ──────────────────────────────────────────────────────────── */
const faqs = [
  {
    q: 'Where can I go rock climbing in Islamabad?',
    a: 'The Margalla Hills around Islamabad have several documented climbing areas, covered on this page: Daman-e-Koh, Said Pur, Trail 3 and Shahdara. The most suitable area depends on your experience, route difficulty, conditions and access.',
  },
  {
    q: 'Is rock climbing in the Margalla Hills suitable for beginners?',
    a: 'Yes, venues such as Jasmin Corner, Holiday Rock and Beetle\u2019s Nest include easier routes suitable for beginners when climbed with appropriate instruction, equipment and supervision.',
  },
  {
    q: 'What grades are available?',
    a: 'Historical climbing documentation describes Margalla climbing from easy 4b ground up to 8a lines on the harder crags. Current route grades and conditions should be confirmed before climbing.',
  },
  {
    q: 'Where does this route information come from?',
    a: 'Route names, grades and descriptions are taken from \u201cMonkey Business \u2013 Margalla Climbing\u201d (John Arran, February 2011). Documented conditions can change, so always confirm current access, grades and fixed gear before you set out.',
  },
  {
    q: 'Can international climbers join Climb Crux?',
    a: 'Yes. Visiting climbers can contact or book Climb Crux for guided outdoor climbing based on their experience and goals.',
  },
  {
    q: 'Do I need my own climbing equipment?',
    a: 'Bring your own personal equipment where possible. Equipment availability should be confirmed with Climb Crux before booking.',
  },
  {
    q: 'What is the best time to climb?',
    a: 'Conditions vary with each season, sun and shade. Early morning or evening may be more comfortable during hotter periods and Day Climbing in Winters.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<MainLayout
  title="Rock Climbing Guide Islamabad | Margalla Hills Climbing | Climb Crux"
  description="A detailed rock climbing guide to Islamabad and the Margalla Hills — climbing areas, venues, route grades, safety and guided climbing sessions."
  image={heroImage}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  {/* ── 1. Hero ───────────────────────────────────────────────────── */}
  <section class="page-header guide-hero">
    {/* Blurred rock-face photo, dark overlay and contour lines — homepage-style. */}
    <div class="guide-hero-media" aria-hidden="true">
      <img class="guide-hero-bg" src={heroBgImage} alt="" />
    </div>
    <svg
      class="guide-hero-topo"
      viewBox="0 0 1440 720"
      preserveAspectRatio="none"
      fill="none"
      stroke="#F47321"
      strokeOpacity=".22"
      strokeWidth="1.3"
      aria-hidden="true"
    >
      <path d="M-50 640C200 560 330 680 560 600S900 460 1100 520 1400 420 1500 460"/>
      <path d="M-50 600C200 520 330 640 560 560S900 420 1100 480 1400 380 1500 420"/>
      <path d="M-50 560C200 480 330 600 560 520S900 380 1100 440 1400 340 1500 380"/>
      <path d="M-50 520C200 440 330 560 560 480S900 340 1100 400 1400 300 1500 340"/>
      <path d="M-50 480C200 400 330 520 560 440S900 300 1100 360 1400 260 1500 300"/>
      <path d="M-50 440C200 360 330 480 560 400S900 260 1100 320 1400 220 1500 260"/>
      <path d="M-50 400C200 320 330 440 560 360S900 220 1100 280 1400 180 1500 220"/>
    </svg>
    <div class="wrap page-header-inner hero-split">
      <div class="hero-copy">
        <h1>
          <span class="h1-orange">Rock Climbing</span>
          <span class="h1-cream">Guide Islamabad</span>
        </h1>
        <div class="page-header-desc">
          <p>A detailed outdoor climbing guide to the Margalla Hills around Islamabad.</p>
          <p>The climbing areas, venues, routes and grades, all in one place.</p>
        </div>
      </div>
      <div class="guide-hero-chart-wrap">
        {/* GradeChart renders inside this frosted-glass card (styled via :global below).
            The caption is the card's own figcaption, below the bars. */}
        <GradeChart client:load data={chartData} libraryBase={ROUTE_LIBRARY_BASE}
          minParam={ROUTE_PARAMS.minGrade} maxParam={ROUTE_PARAMS.maxGrade} mode="filter"
          caption="Islamabad Rock Climbing Routes" />
      </div>
    </div>
    <div class="wrap guide-hero-stats">
      <div class="stats-grid" role="list">
      <div class="stat" role="listitem">
        <span class="stat-value">{String(AREAS.length)}</span>
        <span class="stat-label">Climbing areas</span>
      </div>
      <div class="stat" role="listitem">
        <span class="stat-value">{String(AREAS.reduce((n, a) => n + a.venues.length, 0))}</span>
        <span class="stat-label">Venues</span>
      </div>
      <div class="stat" role="listitem">
        <span class="stat-value">{String(TOTAL_ROUTES)}</span>
        <span class="stat-label">Named routes</span>
      </div>
      <div class="stat" role="listitem">
        <span class="stat-value">{AVAILABLE_GRADES[0]}–{AVAILABLE_GRADES[AVAILABLE_GRADES.length - 1]}</span>
        <span class="stat-label">Grade range</span>
      </div>
    </div>
  </div>
  {/* Curved bottom edge into the cream finder section — homepage wave. */}
  <svg class="guide-hero-wave" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 60C240 10 480 20 720 50S1200 80 1440 30V90H0Z" fill="var(--chalk)" />
  </svg>
</section>

  {/* ── 2. Route guide + climb-by-grade explorer ──────────────────── */}
  <section id="guide-intro" class="section">
    <div class="wrap">
      <div class="guide-explorer-head">
        <h2>Find a route by grade</h2>
        <p class="guide-lede">
          Use the grade range below to find Margalla Hills routes that match your climbing level.
        </p>
      </div>
      <RouteExplorer client:load mode="compact" routes={allRoutes} areas={explorerAreas} />

      <h2 class="guide-credit-heading">Source &amp; Credit</h2>
      <div class="guide-credit">
        <p>
          The route information on this page is drawn from <em>Monkey Business – Margalla Climbing</em>,
          the guidebook that documents the climbing history of these crags.
        </p>
        <blockquote>
          Climb Crux's Margalla Hills Guide draws on Hike &amp; Climb Pakistan's <em>Monkey Business
          – Margalla Climbing</em> by John Arran (February 2011) and other sources to give an overview
          of Islamabad's crags. It is provided for general information and to help you understand the
          history and scale of the climbing here. For accurate, up-to-date conditions before you set
          out, please check with Climb Crux or your local contacts.
        </blockquote>
      </div>
    </div>
  </section>

  {/* ── 7. FAQ ──────────────────────────────────────────────────── */}
  <section class="section guide-faq">
    <div class="wrap">
      <div class="guide-faq-grid">
        <div class="guide-faq-intro">
          <h2>Frequently Asked Questions</h2>
          <p class="guide-lede">
            The essentials for climbing outdoors with Climb Crux in the Margalla Hills areas, grades, equipment and seasons.
          </p>
        </div>
        <div class="faq">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* Header + grade chart side by side. Both elements sit in normal flow so
     nothing overlaps and the charcoal band hugs the content. */
  .guide-hero .hero-split {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(360px, 560px);
    gap: clamp(28px, 4vw, 56px);
    align-items: center;
  }

  .guide-hero .page-header-inner {
    padding-top: 32px;
    padding-bottom: 32px;
  }

  /* Each sentence on its own line, once the copy has room for it (wide
     desktop). Below that, the copy reflows normally instead of clipping. */
  @media (min-width: 1200px) {
    .guide-hero .hero-copy .page-header-desc p {
      max-width: none;
      white-space: nowrap;
    }
  }

  .guide-hero .hero-copy h1 {
    font-size: clamp(2.38rem, 3.96vw, 3.3rem);
    max-width: 100%;
    margin: 0;
    line-height: 1.05;
    /* Drop the shared header's default spacing so the two lines sit tight. */
    padding-bottom: 0;
    margin-bottom: 0;
  }

  /* No underline below either heading; orange line one, cream line two. */
  .guide-hero .hero-copy h1::after {
    display: none;
  }

  .guide-hero .hero-copy h1 {
    text-transform: uppercase;
  }

  .guide-hero .hero-copy h1 span {
    display: block;
  }

  .guide-hero .h1-orange {
    color: var(--orange);
  }

  .guide-hero .h1-cream {
    color: #f7f3ec;
    margin-top: 0.08em;
  }

  .guide-hero .hero-copy .page-header-desc {
    margin-top: 0.6em;
  }

  .guide-hero .hero-copy .page-header-desc p {
    max-width: 42ch;
    font-size: 1.05rem;
    margin: 0;
    line-height: 1.5;
  }

  .guide-hero .hero-copy .page-header-desc p + p {
    margin-top: 0.35em;
  }

  .guide-hero-chart-wrap {
    width: 100%;
    max-width: 480px;
    justify-self: end;
  }


  /* Keep the "Find a route by grade" intro on a single line on desktop. */
  @media (min-width: 660px) {
    .guide-explorer-head .guide-lede {
      max-width: none;
      white-space: nowrap;
    }
  }

  /* Stats card mirrors the home-page stats card (white card, 4 columns,
     orange Oswald numbers, uppercase labels). Full width like the finder. */
  .guide-hero .stats-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    width: 100%;
    margin: 0;
    padding: 34px 0 36px;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 24px 60px rgba(31, 31, 33, 0.18);
    box-sizing: border-box;
  }

  .guide-hero .stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 0 clamp(24px, 3vw, 48px);
    text-align: left;
    border-right: 1px solid #e8e2d7;
  }

  .guide-hero .stat:last-child {
    border-right: 0;
  }

  .guide-hero .stat-value {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1;
    color: #f47321;
    white-space: nowrap;
  }

  .guide-hero .stat-label {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.8rem;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6b6b6f;
    max-width: none;
  }

  @media (max-width: 1100px) {
    .guide-hero .stat {
      padding: 0 18px;
    }
  }

  @media (max-width: 980px) {
    .hero-split,
    .guide-hero .hero-split {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .guide-hero .guide-hero-chart-wrap {
      max-width: 520px;
    }
  }

  @media (max-width: 800px) {
    .guide-hero .stats-grid {
      grid-template-columns: 1fr 1fr;
      row-gap: 24px;
      padding: 22px 0;
    }

    .guide-hero .stat:nth-child(2) {
      border-right: 0;
    }

    .guide-hero .stat:nth-child(3) {
      border-right: 1px solid #e8e2d7;
    }

    .guide-hero .stat-value {
      font-size: 1.9rem;
    }
  }

  @media (max-width: 500px) {
    .guide-hero .stats-grid {
      row-gap: 18px;
      padding: 18px 0;
      border-radius: 12px;
    }

    .guide-hero .stat {
      padding: 0 12px;
    }

    .guide-hero .stat:nth-child(2),
    .guide-hero .stat:nth-child(4) {
      border-right: 0;
    }

    .guide-hero .stat-value {
      font-size: 1.7rem;
    }

    .guide-hero .stat-label {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
    }
  }

  /* ============================== FULL-WIDTH ROUTE FINDER ============================== */

  /* Only this section escapes the 1180px .wrap cap — the token itself and the
     global utility stay untouched. */
  #guide-intro .wrap {
    max-width: none;
    padding-inline: clamp(20px, 4vw, 64px);
  }

  /* ============================== HOMEPAGE-STYLE HERO ============================== */

  .guide-hero {
    position: relative;
    overflow: hidden;
    background: #1f1f21;
    padding-bottom: 0; /* the wave closes the section */
  }

  /* Align the hero with the full-width route finder below it. */
  .guide-hero .wrap {
    max-width: none;
    padding-inline: clamp(20px, 4vw, 64px);
  }

  /* Blurred rock-face photo, clipped inside its own layer so the blur can
     overhang without ever widening the page. */
  .guide-hero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .guide-hero-media img {
    position: absolute;
    inset: -30px;
    width: calc(100% + 60px);
    height: calc(100% + 60px);
    max-width: none;
    object-fit: cover;
    filter: blur(14px) brightness(0.38) saturate(1.1);
  }

  /* Dark overlay with a warm lift on the chart side — mirrors the homepage. */
  .guide-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      100deg,
      rgba(31, 31, 33, 0.94) 0%,
      rgba(31, 31, 33, 0.78) 45%,
      rgba(244, 115, 33, 0.14) 100%
    );
  }

  .guide-hero-topo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    opacity: 0.5;
    pointer-events: none;
  }

  .guide-hero .page-header-inner {
    position: relative;
    z-index: 2;
  }

  .guide-hero .page-header-desc p {
    color: #c9c4b8;
  }

  /* Frosted-glass card behind/around the GradeChart. The chart island is
     reached with :global, since Astro scoping stops at the island boundary. */
  .guide-hero-chart-wrap :global(.gc) {
    background: rgba(31, 31, 33, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 14px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
  }

  /* The white stats card sits above the wave, overlapping the hero bottom. */
  .guide-hero-stats {
    position: relative;
    z-index: 3;
    margin-top: 36px;
  }

  /* Roomier card and larger orange numbers on desktop only — the existing
     small-screen values below stay in force. */
  @media (min-width: 801px) {
    .guide-hero .stat-value {
      font-size: clamp(2.4rem, 2.8vw, 3rem);
    }
  }

  /* Curved bottom edge into the cream section, tucked behind the stats card. */
  .guide-hero-wave {
    position: relative;
    display: block;
    width: 100%;
    height: clamp(44px, 6vw, 90px);
    margin-top: -70px;
    z-index: 1;
  }

  @media (max-width: 980px) {
    .guide-hero-chart-wrap {
      margin-inline: auto;
    }
  }
</style>