---
import MainLayout from '../layouts/MainLayout.astro';
import AboutContent from '../components/react/AboutContent.jsx';
import { getAbout } from '../lib/api';
import '../styles/About.css';

const about = await getAbout().catch(() => null);
---

<MainLayout
  title="About Climb Crux — Rock Climbing Club in Islamabad"
  description="Learn about Climb Crux Pakistan — the rock climbing club in Islamabad making Margalla Hills accessible to everyone. Certified instructors, top safety standards, and a passion for the climb."
>
  <AboutContent client:load initial={{ about }} />
</MainLayout>
