---
import MainLayout from '../layouts/MainLayout.astro';
import AboutContent from '../components/react/AboutContent.jsx';
import { getAbout } from '../lib/api';
import '../styles/About.css';

const about = await getAbout().catch(() => null);
---

<MainLayout>
  <Fragment slot="head">
    <title>About Climb Crux — Rock Climbing Club in Islamabad</title>
    <meta name="description" content="Learn about Climb Crux Pakistan — the rock climbing club in Islamabad making Margalla Hills accessible to everyone. Certified instructors, top safety standards, and a passion for the climb." />
  </Fragment>

  <AboutContent client:load initial={{ about }} />

  <section class="cta-band">
    <div class="wrap cta-inner">
      <h2>Ready to climb with Islamabad's rock climbing club?</h2>
      <p>Join a public session, book a private climb with a certified instructor, or come say hi on Instagram.</p>
      <div class="cta-actions">
        <a href="/sessions" class="btn btn-primary">Join a public session</a>
        <a href="/book-now" class="btn btn-outline-light">Book now</a>
      </div>
    </div>
  </section>
</MainLayout>
