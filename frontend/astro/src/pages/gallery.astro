---
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/astro/PageHeader.astro';
import Gallery from '../components/react/Gallery.jsx';
---

<MainLayout>
  <Fragment slot="head">
    <title>Gallery — Climb Crux Pakistan</title>
    <meta name="description" content="A running record of climbing sessions on Margalla Hills, Islamabad — public climbs, private coaching and group training captured on the limestone walls." />
  </Fragment>
  <PageHeader title="From the wall.">
    <p slot="default">A running record of sessions on Margalla Hills. Public climbs, Private coaching and Group Training.</p>
  </PageHeader>
  <Gallery client:load />
</MainLayout>
