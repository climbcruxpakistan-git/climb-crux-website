---
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/astro/PageHeader.astro';
import Gallery from '../components/react/Gallery.jsx';
---

<MainLayout>
  <Fragment slot="head">
    <title>Gallery — Climb Crux Pakistan</title>
    <meta name="description" content="Photos from climbing sessions on Margalla Hills — public climbs, private coaching, and premium ascents captured on the limestone walls of Islamabad." />
  </Fragment>
  <PageHeader title="From the wall.">
    <p slot="default">A running record of sessions on Margalla Hills — public climbs, private coaching, and premium ascents.</p>
  </PageHeader>
  <Gallery client:load />
</MainLayout>
