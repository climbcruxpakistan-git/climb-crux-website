---
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/astro/PageHeader.astro';
import BookNow from '../components/react/BookNow.jsx';

// On-demand render: so the ?type= query param (from the card CTA buttons) is
// read per-request instead of being baked into static HTML at build time.
export const prerender = false;

const preselected = Astro.url.searchParams.get('type') || '';
---

<MainLayout
  title="Book a Climbing Session — Climb Crux Pakistan"
  description="Pick the session that fits — a public group climb, a discounted monthly membership, or a private experience built around your goals on Margalla Hills, Islamabad."
>
  <PageHeader title="Book your climb.">
    <p slot="default">Pick the session that fits. A public group climb, a discounted monthly membership or a private experience built around your goals.</p>
  </PageHeader>
  <BookNow client:load preselected={preselected} />
</MainLayout>
