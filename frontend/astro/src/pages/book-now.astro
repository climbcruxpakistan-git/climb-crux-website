---
import MainLayout from '../layouts/MainLayout.astro';
import PageHeader from '../components/astro/PageHeader.astro';
import BookNow from '../components/react/BookNow.jsx';

const preselected = Astro.url.searchParams.get('type') || '';
---

<MainLayout>
  <Fragment slot="head">
    <title>Book a Climbing Session — Climb Crux Pakistan</title>
    <meta name="description" content="Reserve your spot for guided rock climbing on Margalla Hills. Choose a public session, a monthly membership, or private coaching in Islamabad." />
  </Fragment>
  <PageHeader title="Book your climb.">
    <p slot="default">Pick the session that fits — a public group climb, a discounted monthly membership, or a private experience built around your goals.</p>
  </PageHeader>
  <BookNow client:load preselected={preselected} />
</MainLayout>
