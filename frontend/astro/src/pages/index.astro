---
import MainLayout from '../layouts/MainLayout.astro';
import HomeContent from '../components/react/HomeContent.jsx';
import { getHomeContent, getUploads } from '../lib/api';
import '../styles/Home.css';

const content = await getHomeContent().catch(() => null);
const uploads = await getUploads().catch(() => []);

const heroTitle = content?.heroTitle || 'Discover Rock Climbing in Islamabad';
const heroLede = content?.heroLede || "Climb Crux is Islamabad's premier rock climbing club, offering professionally guided rock climbing sessions, expert coaching, monthly memberships and a supportive community for beginners and experienced climbers.";
const heroPhotoUrl = content?.heroPhotoUrl || 'https://res.cloudinary.com/ivvx77mg/image/upload/v1785872185/climb-crux/eswc8bon6d6ognvow4mj.jpg';
const paths = content?.paths || [
  { grade: '4 – 6a', label: 'Beginner Friendly', title: 'Public Sessions', copy: 'Drop into a guided group session on Margalla Hills every other week. No experience or gear needed — just a willingness to get chalky hands.', to: '/sessions', cta: 'See schedule & pricing' },
  { grade: 'Up to 7c+', label: 'Custom & Premium', title: 'Private & Premium', copy: 'Book a private slot for your group or go one-on-one with an instructor. Premium plans open the door to the hardest routes we run.', to: '/private-premium', cta: 'Explore plans' },
];
const teasers = content?.teasers || [
  { tag: 'Public Session · 4+' }, { tag: 'Private Coaching · 1-on-1' }, { tag: 'Premium Ascent · 7c+' },
];
const pathsEyebrow = content?.pathsEyebrow || 'Two ways to climb with us';
const pathsTitle = content?.pathsTitle || 'Pick your route';
const teasersEyebrow = content?.teasersEyebrow || 'From the wall';
const teasersTitle = content?.teasersTitle || 'A look at recent sessions';
const teaserSessionSlug = content?.teaserSessionSlug || '';

const initial = {
  heroTitle,
  heroLede,
  heroPhotoUrl,
  paths,
  teasers,
  pathsEyebrow,
  pathsTitle,
  teasersEyebrow,
  teasersTitle,
  teaserSessionSlug,
  uploads,
};
---

<MainLayout
  title="Rock Climbing in Islamabad & Pakistan | Climb Crux"
  description="Rock climbing in Islamabad & Pakistan with Climb Crux — guided sessions on the limestone crags of Margalla Hills. Beginner-friendly, all gear provided, certified instructors."
>

  <HomeContent client:load initial={initial} />

  <section class="section local-seo-section">
    <div class="wrap">
      <h2>Rock climbing in Pakistan</h2>
      <div class="local-seo-copy">
        <p>Pakistan is home to some of the most dramatic climbing on earth — from the granite walls of the Karakoram to accessible crags close to the cities. For most climbers, the journey starts on the limestone cliffs of Margalla Hills in Islamabad, where Climb Crux runs guided sessions every other Sunday.</p>
        <p>Whether you're in Islamabad, Rawalpindi, Lahore or Karachi, our public sessions, monthly memberships and private coaching are built for beginners and experienced climbers alike. All gear is provided and every session is led by certified instructors who handle the safety so you can focus on the climb.</p>
        <a href="/sessions" class="btn btn-outline">See session dates &amp; pricing</a>
        <a href="/shop" class="btn btn-outline">Shop climbing gear in Pakistan</a>
      </div>
    </div>
  </section>
</MainLayout>
