---
import MainLayout from '../layouts/MainLayout.astro';
import RouteExplorer from '../components/react/RouteExplorer.jsx';
import { optimizeImage } from '../lib/api';
import {
  AREAS,
  MARGALLA_SOURCE,
  flattenRoutes,
  formatGrade,
  TOTAL_ROUTES,
} from '../data/margallaRoutes';
import { routeLibraryHref } from '../lib/routeFilters';
import '../styles/RockClimbingGuide.css';

/**
 * Rock Climbing Guide to Pakistan — a static SEO / resource page.
 *
 * Content rules this page follows:
 *  · Current Climb Crux information comes from the live session system, or is
 *    described as a Climb Crux offering (public / private sessions).
 *  · Route names, grades and descriptions taken from "Monkey Business — A
 *    Guide to Climbing in Margalla" (John Arran, February 2011) are always
 *    labelled as historical, never presented as current.
 *  · Anything that can change (access, meeting points, conditions, grades,
 *    equipment availability) is written cautiously and deferred to the live
 *    booking system.
 */

// Existing Climb Crux hero photograph — the same verified Cloudinary asset used
// by the home-page hero (see backend/src/models/HomeContent.js). Not invented.
// Kept here only as the page's social share (og:image) preview.
const HERO_IMAGE_SOURCE = 'https://res.cloudinary.com/ivvx77mg/image/upload/v1785872185/climb-crux/eswc8bon6d6ognvow4mj.jpg';
const heroImage = optimizeImage(HERO_IMAGE_SOURCE, 1400);

/* ── Route data ───────────────────────────────────────────────────── */
const allRoutes = flattenRoutes();

// Shape the areas into what the explorer expects (id, name, venues) — the same
// data the route library passes to its full-mode explorer.
const explorerAreas = AREAS.map((area) => ({
  id: area.id,
  name: area.name,
  venues: area.venues.map((venue) => ({ id: venue.id, name: venue.name })),
}));

// Documented routes per climbing area — drives the area-card links into the
// route library, so the count can never drift from the data.
const routeCountByArea = new Map(
  AREAS.map((area) => [area.id, area.venues.reduce((n, venue) => n + venue.routes.length, 0)])
);

const totalVenues = AREAS.reduce((n, area) => n + area.venues.length, 0);
const statChips = [
  { k: String(AREAS.length), v: 'Climbing areas' },
  { k: String(totalVenues), v: 'Venues' },
  { k: String(TOTAL_ROUTES), v: 'Named routes' },
];

/* ── Equipment, Grades & Safety ───────────────────────────────────── */
const gradePoints = [
  'The Margalla crags documented on this page use French sport grades, from easy 4b beginner ground at Jasmin Corner up to sustained 8a lines at Jungle Rock and Well Hidden Rock.',
  "A '+' marks the harder end of a grade — 6a+ sits between 6a and 6b, 6b+ between 6b and 6c.",
  'Most lines here are sport climbs on fixed bolts. A few are different: Cultural Divide at Well Hidden Rock is a trad route graded VS (5a), and Maverick at Belvedere is not yet bolted and is only climbed on top-rope.',
  'Grades record difficulty at the time they were documented and can change with holds, bolts and rock condition — confirm them before you set out.',
];

const safetyPoints = [
  "Carry, place and check quickdraws for the sport routes. A 60m rope covers the tall crags; most routes need far less. Teamwork at Belvedere is four pitches — the descent is usually by abseil, and two ropes are useful for the 40m abseil directly from the pitch 2 belay.",
  'Wear a helmet. Several route notes warn of loose rock — the first metres at God Rock are described as inherently very loose, and loose rock is reported near the tops at Said Pur View.',
  'Treat fixed gear with care — bolts, hangers and anchors age in the open, and a few routes (such as Saxony Ramp) have had their bolts removed.',
  'Approaches follow informal hillside paths through seasonal bush; underfoot loose rock is normal. Respect the hillside and the local area, and keep paths clear of returned bushes where you can.',
  'Climbing is at your own risk. Conditions, access and fixed gear should always be re-verified before a visit.',
];

/* ── Visiting Pakistan? ───────────────────────────────────────────── */
const internationalClimbers = [
  'Bring your personal climbing shoes if possible.',
  'Let us know your climbing experience and preferred grades.',
  'Tell us whether you are looking for a beginner experience, sport climbing or harder climbing.',
  'We can recommend a suitable climbing area and session format.',
  'Equipment availability should be confirmed before the session.',
];

/* ── Climb with Climb Crux ────────────────────────────────────────── */
const climbOptions = [
  {
    h: 'Public Sessions',
    p: 'Join a scheduled outdoor climbing session on the Margalla Hills, with certified instruction and safety cover.',
    cta: 'View Public Sessions',
    href: '/sessions',
  },
  {
    h: 'Private Sessions',
    p: 'Book a private climbing experience tailored to your group, your goals and your ability.',
    cta: 'Explore Private Sessions',
    href: '/private-premium',
  },
  {
    h: 'Experienced Climbers',
    p: 'Already climbing outdoors and want to explore Margalla climbing with local guidance? Arrange a session around the routes you want to try.',
    cta: 'Book a Private Session',
    href: '/book-now?type=private-starter',
  },
];

/* ── FAQ ──────────────────────────────────────────────────────────── */
const faqs = [
  {
    q: 'Where can I go rock climbing in Islamabad?',
    a: 'The Margalla Hills around Islamabad have several documented climbing areas, covered on this page: Daman-e-Koh, Said Pur, Trail 3 and Shaddarrah. The most suitable area depends on your experience, route difficulty, conditions and access.',
  },
  {
    q: 'Is rock climbing in the Margalla Hills suitable for beginners?',
    a: 'Yes — venues such as Jasmin Corner, Holiday Rock and Beetle\u2019s Nest include easier routes suitable for beginners when climbed with appropriate instruction, equipment and supervision.',
  },
  {
    q: 'What grades are available?',
    a: 'Historical climbing documentation describes Margalla climbing from easy 4b ground up to 8a lines on the harder crags. Current route grades and conditions should be confirmed before climbing.',
  },
  {
    q: 'Where does this route information come from?',
    a: 'Route names, grades and descriptions are taken from \u201cMonkey Business \u2013 Margalla Climbing\u201d (John Arran, February 2011). Documented conditions can change, so always confirm current access, grades and fixed gear before you set out.',
  },
  {
    q: 'Can international climbers join Climb Crux?',
    a: 'Yes. Visiting climbers can contact or book Climb Crux for guided outdoor climbing based on their experience and goals.',
  },
  {
    q: 'Do I need my own climbing equipment?',
    a: 'Bring your own personal equipment where possible. Equipment availability should be confirmed with Climb Crux before booking.',
  },
  {
    q: 'What is the best time to climb?',
    a: 'Conditions vary with season, temperature, humidity, sun and shade. The route notes on this page describe which crags get sun or shade when — early morning or evening may be more comfortable during hotter periods.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<MainLayout
  title="Rock Climbing Guide to Pakistan | Islamabad & Margalla Hills | Climb Crux"
  description="A detailed rock climbing guide to Islamabad and the Margalla Hills — climbing areas, venues, route grades, safety and guided sessions."
  image={heroImage}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  {/* ── 1. Hero ───────────────────────────────────────────────────── */}
  <section class="page-header guide-hero">
    <div class="page-header-pattern"></div>
    <div class="page-header-accent"></div>
    <div class="wrap page-header-inner guide-hero-inner">
      <h1>Rock Climbing Guide to Pakistan</h1>
      <div class="page-header-desc">
        <p>
          A detailed outdoor climbing guide to the Margalla Hills around Islamabad — the climbing
          areas, venues, routes and grades, all in one place.
        </p>
      </div>
      <div class="guide-hero-actions">
        <a class="btn btn-primary" href="/book-now?type=public">Book a Climbing Session</a>
        <a class="btn btn-outline-light" href="/routes">Browse All Routes</a>
      </div>
    </div>
  </section>

  {/* ── 2. Guide introduction ─────────────────────────────────────── */}
  <section id="guide-intro" class="section">
    <div class="wrap">
      <span class="eyebrow">The Margalla Hills</span>
      <h2>A Route Guide to Islamabad's Crags</h2>
      <p class="guide-lede">
        The Margalla Hills are Islamabad's backyard climbing ground. The routes documented on this
        page span four climbing areas — Daman-e-Koh, Said Pur, Trail 3 and Shaddarrah — from easy
        beginner ground at Jasmin Corner to sustained, powerful lines like Out of Action and
        Islamagood.
      </p>
      <p class="guide-lede">
        Most routes are sport climbs on fixed bolts. A few are different: Cultural Divide at Well
        Hidden Rock is a classic trad route, and a couple of faces are not bolted at all. Use the
        Route Explorer to filter the whole library by grade, area or venue in an instant, then read
        the venue notes below for character, approach, shade and rock quality before you set off.
      </p>
      <div class="guide-stats" role="list">
        {statChips.map((chip) => (
          <div class="guide-stat" role="listitem">
            <b>{chip.k}</b>
            <span>{chip.v}</span>
          </div>
        ))}
      </div>
      <p class="guide-section-note">
        Route names, grades and descriptions are taken from <em>Monkey Business – Margalla Climbing</em>
        ({MARGALLA_SOURCE.author}, {MARGALLA_SOURCE.published}). Documented conditions change — always
        re-check access, grades and fixed gear before you climb.
      </p>
    </div>
  </section>

  {/* ── 3. Climbing areas overview ────────────────────────────────── */}
  <section id="climbing-areas" class="section guide-tint">
    <div class="wrap">
      <span class="eyebrow">Areas at a glance</span>
      <h2>Climbing Areas</h2>
      <p class="guide-lede">
        The crags are grouped into four areas around Islamabad. Step down to the detailed venue
        sections below, jump straight to a venue from its card, or open the complete route library
        with that area's routes already filtered.
      </p>
      <div class="guide-areas-grid">
        {AREAS.map((area) => (
          <article class="guide-area-card">
            <div class="guide-area-card-head">
              <span class="guide-area-num" aria-hidden="true">{String(AREAS.indexOf(area) + 1).padStart(2, '0')}</span>
              <h3><a href={`#${area.id}`}>{area.name}</a></h3>
            </div>
            <p>{area.lede}</p>
            <ul class="guide-venue-links">
              {area.venues.map((venue) => (
                <li><a href={`#${venue.id}`}>{venue.name}</a></li>
              ))}
            </ul>
            {routeCountByArea.get(area.id) > 0 && (
              <a class="guide-area-card-link" href={routeLibraryHref({ area: area.id })}>
                View all {routeCountByArea.get(area.id)} routes in {area.name} &rarr;
              </a>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ── 4. Explore routes by grade (compact explorer) ─────────────── */}
  <section id="explore-routes" class="section">
    <div class="wrap">
      <span class="eyebrow">Plan your climb</span>
      <h2>Explore Routes by Grade</h2>
      <p class="guide-lede">
        Find routes that match your climbing level using the grade range below. Drag either handle
        to set a minimum and maximum grade — the results update as you go, ordered by climbing
        grade rather than alphabetically. The complete, searchable library lives on the
        {' '}<a href="/routes">route library page</a>.
      </p>
      <RouteExplorer client:load mode="compact" routes={allRoutes} areas={explorerAreas} />
      <p class="guide-section-note">
        Grades are the source guide's French sport grades. Multi-pitch lines are graded by their
        hardest pitch, so Teamwork is listed under 6c+ even though its first pitch is 4a.
      </p>
    </div>
  </section>

  {/* ── 5. Venues & routes in detail ──────────────────────────────── */}
  <section id="routes" class="section guide-tint">
    <div class="wrap">
      <span class="eyebrow">Where to climb</span>
      <h2>Venues &amp; Routes in Detail</h2>
      <p class="guide-lede">
        Character, approach and a few highlighted routes for each venue — a taste of what's on
        offer. Follow the venue links to filter the complete route library. Approach times are from
        the source guide and may change with conditions.
      </p>

      {AREAS.map((area) => (
        <div class="guide-area" id={area.id}>
          <h3 class="guide-area-name">{area.name}</h3>
          {area.lede && <p class="guide-area-lede">{area.lede}</p>}

          {area.venues.map((venue) => (
            <article class="venue-block" id={venue.id}>
              <header class="venue-head">
                <h4>{venue.name}</h4>
                <span class="venue-meta">
                  {venue.gradeRange}
                  {venue.routes.length > 0
                    ? <> · {venue.routes.length} {venue.routes.length === 1 ? 'route' : 'routes'}</>
                    : <> · No individual routes documented</>}
                </span>
              </header>

              {venue.character && <p class="venue-character">{venue.character}</p>}

              {venue.approach && (
                <div class="venue-approach">
                  <h5>Approach</h5>
                  <p>{venue.approach}</p>
                </div>
              )}

              {venue.notes?.length > 0 && (
                <ul class="venue-notes">
                  {venue.notes.map((note) => <li>{note}</li>)}
                </ul>
              )}

              {venue.routes.length > 0 && (
                <>
                  <ul class="venue-routes" role="list">
                    {venue.routes.slice(0, 3).map((route) => (
                      <li class="route-row">
                        <div class="route-row-head">
                          <span class="route-name">{route.name}</span>
                          <span class="route-meta">
                            <span class="route-grade">{formatGrade(route)}</span>
                            {route.length && <span class="route-len">{route.length}m</span>}
                            {route.type === 'multi-pitch' && <span class="route-tag">Multi-pitch</span>}
                            {route.type === 'trad' && <span class="route-tag">Trad</span>}
                            {route.variation && <span class="route-tag">Variation</span>}
                          </span>
                        </div>
                        {route.pitches ? (
                          <p class="route-desc">
                            Four pitches from ~5m to 30m long; the hardest moves are 6c+. See the
                            pitch-by-pitch breakdown below. Descent is usually by abseil — two ropes
                            are useful to abseil 40m directly from the pitch 2 belay.
                          </p>
                        ) : (
                          <p class="route-desc">{route.description}</p>
                        )}
                        {route.pitches && (
                          <ul class="route-pitches" role="list">
                            {route.pitches.map((pitch) => (
                              <li>
                                <span class="pitch-label">{pitch.label}</span>
                                <span class="pitch-grade">{pitch.grade}</span>
                                {pitch.length && <span class="pitch-len">{pitch.length}m</span>}
                                <span class="pitch-desc">{pitch.description}</span>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                  <a
                    class="venue-all-link"
                    href={routeLibraryHref({ area: area.id, venue: venue.id })}
                  >
                    View all {venue.routes.length} {venue.routes.length === 1 ? 'route' : 'routes'} &rarr;
                  </a>
                </>
              )}
            </article>
          ))}
        </div>
      ))}
    </div>
  </section>

  {/* ── 6. Equipment, Grades & Safety ─────────────────────────────── */}
  <section id="equipment-safety" class="section">
    <div class="wrap">
      <span class="eyebrow">On the rock</span>
      <h2>Equipment, Grades &amp; Safety</h2>
      <p class="guide-lede">
        How the grades work on these crags, and the essentials for climbing safely. Details below
        are drawn from the source guide's route notes plus general safe practice.
      </p>
      <div class="guide-safety-grid">
        <div class="guide-safety-col">
          <h3>Grades &amp; route names</h3>
          <ul class="guide-list is-check">
            {gradePoints.map((point) => <li>{point}</li>)}
          </ul>
        </div>
        <div class="guide-safety-col">
          <h3>Equipment &amp; safety</h3>
          <ul class="guide-list is-check">
            {safetyPoints.map((point) => <li>{point}</li>)}
          </ul>
        </div>
      </div>
      <p class="guide-section-note">
        These crags are undeveloped, informal climbing areas — routes, bolts and access are not
        managed. Climb at your own risk, re-check everything on the ground, and ask Climb Crux or
        local climbers for current conditions.
      </p>
    </div>
  </section>

  {/* ── 7. Source & Credit ────────────────────────────────────────── */}
  <section id="source-credit" class="section">
    <div class="wrap">
      <span class="eyebrow">Source</span>
      <h2>Source &amp; Credit</h2>
      <div class="guide-credit">
        <p>
          The route information on this page is drawn from <em>Monkey Business – Margalla Climbing</em>,
          the guidebook that documents the climbing history of these crags.
        </p>
        <blockquote>
          Climb Crux's Margalla Hills Guide draws on Hike &amp; Climb Pakistan's <em>Monkey Business
          – Margalla Climbing</em> by John Arran (February 2011) and other sources to give an overview
          of Islamabad's crags. It is provided for general information and to help you understand the
          history and scale of the climbing here. For accurate, up-to-date conditions before you set
          out, please check with Climb Crux or your local contacts.
        </blockquote>
      </div>
    </div>
  </section>

  {/* ── 8. Climb with Climb Crux ──────────────────────────────────── */}
  <section class="section guide-tint">
    <div class="wrap">
      <span class="eyebrow">Guided climbing</span>
      <h2>Climb With Climb Crux</h2>
      <div class="guide-grid">
        {climbOptions.map((option, i) => (
          <article class="guide-card">
            <span class="guide-card-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{option.h}</h3>
            <p>{option.p}</p>
            <a class="btn btn-primary" href={option.href}>{option.cta}</a>
          </article>
        ))}
      </div>
      <p class="guide-section-note">
        Every climbing session is led by certified instructors — you can
        {' '}<a href="/our-team">meet the instructors</a> behind your climb.
      </p>
    </div>
  </section>

  {/* ── 9. Visiting Pakistan? ────────────────────────────────────── */}
  <section class="section">
    <div class="wrap">
      <div class="guide-intl-grid">
        <div class="guide-intl-copy">
          <span class="eyebrow">International climbers</span>
          <h2>Visiting Pakistan?</h2>
          <p class="guide-lede">
            Islamabad is a practical base for exploring the outdoor climbing of the Margalla Hills. If
            you're visiting Pakistan and want to climb outdoors, Climb Crux can help you plan a guided
            session based on your experience, preferred difficulty and available time.
          </p>
          <div class="guide-hero-actions">
            <a class="btn btn-primary" href="/book-now?type=public">Book a Climbing Session</a>
            <a class="btn btn-outline" href="/our-team">Meet Our Instructors</a>
          </div>
        </div>
        <aside class="guide-intl-panel">
          <h3>Before you arrive</h3>
          <ul class="guide-list is-check">
            {internationalClimbers.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      </div>
    </div>
  </section>

  {/* ── 10. FAQ ──────────────────────────────────────────────────── */}
  <section class="section guide-faq">
    <div class="wrap">
      <div class="guide-faq-grid">
        <div class="guide-faq-intro">
          <span class="eyebrow">Good to know</span>
          <h2>Frequently Asked Questions</h2>
          <p class="guide-lede">
            The essentials for climbing outdoors with Climb Crux in the Margalla Hills — areas,
            grades, equipment and seasons.
          </p>
        </div>
        <div class="faq">
          {faqs.map((faq) => (
            <details>
              <summary>{faq.q}</summary>
              <p>{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</MainLayout>