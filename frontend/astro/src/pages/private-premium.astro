---
import MainLayout from '../layouts/MainLayout.astro';
import PremiumContent from '../components/react/PremiumContent.jsx';
import { getPlans, getSessionContent } from '../lib/api';
import '../styles/PrivatePremium.css';

const [plans, content] = await Promise.all([
  getPlans().catch(() => []),
  getSessionContent().catch(() => ({})),
]);
---

<MainLayout>
  <Fragment slot="head">
    <title>Private & Premium Climbing — Climb Crux Pakistan</title>
    <meta name="description" content="Private rock climbing sessions in Islamabad and premium plans on Margalla Hills. Solo coaching, group bookings, adventure events or custom climbs. Book your private session." />
  </Fragment>

  <PremiumContent client:load initial={{ plans, content }} />
</MainLayout>
