---
import MainLayout from '../layouts/MainLayout.astro';
import PremiumContent from '../components/react/PremiumContent.jsx';
import ReviewsSection from '../components/react/ReviewsSection.jsx';
import { getPlans, getSessionContent } from '../lib/api';
import '../styles/PrivatePremium.css';
import '../styles/Reviews.css';

const [plans, content] = await Promise.all([
  getPlans().catch(() => []),
  getSessionContent().catch(() => ({})),
]);
---

<MainLayout
  title="Private & Premium Climbing — Climb Crux Pakistan"
  description="Private rock climbing sessions in Islamabad and premium plans on Margalla Hills. Solo coaching, group bookings, adventure events or custom climbs. Book your private session."
>

  <PremiumContent client:load initial={{ plans, content }} />

  {/* Reviews & Ratings — Private Session reviews only (approved, type enforced server-side) */}
  <ReviewsSection client:load type="private" />
</MainLayout>
