---
import MainLayout from '../../../layouts/MainLayout.astro';
import PageHeader from '../../../components/astro/PageHeader.astro';
import EasyPaisaConfirmation from '../../../components/react/EasyPaisaConfirmation.jsx';

// Rendered on-demand so any booking number works after a customer books.
export const prerender = false;

const { bookingNumber } = Astro.params;
---

<MainLayout>
  <Fragment slot="head">
    <title>Payment Submitted for Verification — Climb Crux Pakistan</title>
    <meta name="description" content="Your EasyPaisa payment proof has been submitted for verification — Climb Crux rock climbing bookings in Islamabad on Margalla Hills." />
  </Fragment>
  <PageHeader title="Payment Submitted for Verification">
    <p slot="default">Your payment proof has been submitted and is awaiting verification by our team.</p>
  </PageHeader>
  <EasyPaisaConfirmation client:load bookingNumber={bookingNumber} />
</MainLayout>
