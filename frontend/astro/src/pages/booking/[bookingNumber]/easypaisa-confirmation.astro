---
import MainLayout from '../../../layouts/MainLayout.astro';
import PageHeader from '../../../components/astro/PageHeader.astro';
import EasyPaisaConfirmation from '../../../components/react/EasyPaisaConfirmation.jsx';

export async function getStaticPaths() {
  return [{ params: { bookingNumber: '_placeholder' } }]
}

const { bookingNumber } = Astro.params;
---

<MainLayout>
  <Fragment slot="head">
    <title>EasyPaisa Payment Confirmation — Climb Crux Pakistan</title>
    <meta name="description" content="Complete your EasyPaisa transfer to confirm your rock climbing booking in Islamabad with Climb Crux on Margalla Hills." />
  </Fragment>
  <PageHeader title="Payment confirmation.">
    <p slot="default">Here's what you need to complete your EasyPaisa transfer.</p>
  </PageHeader>
  <EasyPaisaConfirmation client:load bookingNumber={bookingNumber} />
</MainLayout>
