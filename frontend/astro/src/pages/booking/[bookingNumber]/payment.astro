---
import MainLayout from '../../../layouts/MainLayout.astro';
import PageHeader from '../../../components/astro/PageHeader.astro';
import PaymentPage from '../../../components/react/PaymentPage.jsx';

// Rendered on-demand so any booking number works after a customer books.
export const prerender = false;

const { bookingNumber } = Astro.params;
---

<MainLayout>
  <Fragment slot="head">
    <title>Complete Your Payment — Climb Crux Pakistan</title>
    <meta name="description" content="Review your climbing booking and complete payment for your rock climbing session in Islamabad — bank transfer or EasyPaisa." />
  </Fragment>
  <PageHeader title="Complete your payment.">
    <p slot="default">Review your booking details and choose how you'd like to pay.</p>
  </PageHeader>
  <PaymentPage client:load bookingNumber={bookingNumber} />
</MainLayout>
