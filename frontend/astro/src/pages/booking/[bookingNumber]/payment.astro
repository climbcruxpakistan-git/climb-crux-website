---
import MainLayout from '../../../layouts/MainLayout.astro';
import PageHeader from '../../../components/astro/PageHeader.astro';
import PaymentPage from '../../../components/react/PaymentPage.jsx';

export async function getStaticPaths() {
  return [{ params: { bookingNumber: '_placeholder' } }]
}

const { bookingNumber } = Astro.params;
---

<MainLayout>
  <PageHeader title="Complete your payment.">
    <p slot="default">Review your booking details and choose how you'd like to pay.</p>
  </PageHeader>
  <PaymentPage client:load bookingNumber={bookingNumber} />
</MainLayout>
