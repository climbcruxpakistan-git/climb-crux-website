---
import MainLayout from '../../../layouts/MainLayout.astro';
import BankTransferConfirmation from '../../../components/react/BankTransferConfirmation.jsx';

// Rendered on-demand so any booking number works after a customer books.
export const prerender = false;

const { bookingNumber } = Astro.params;
---

<MainLayout
  title="Payment Submitted for Verification — Climb Crux Pakistan"
  description="Your bank transfer payment proof has been submitted for verification — Climb Crux rock climbing bookings in Islamabad on Margalla Hills."
  noindex
>
  <BankTransferConfirmation client:load bookingNumber={bookingNumber} />
</MainLayout>
