---
import MainLayout from '../../../layouts/MainLayout.astro';
import PageHeader from '../../../components/astro/PageHeader.astro';
import BankTransferConfirmation from '../../../components/react/BankTransferConfirmation.jsx';

export async function getStaticPaths() {
  return [{ params: { bookingNumber: '_placeholder' } }]
}

const { bookingNumber } = Astro.params;
---

<MainLayout>
  <Fragment slot="head">
    <title>Bank Transfer Payment Confirmation — Climb Crux Pakistan</title>
    <meta name="description" content="Complete your bank transfer to confirm your rock climbing booking in Islamabad with Climb Crux on Margalla Hills." />
  </Fragment>
  <PageHeader title="Payment confirmation.">
    <p slot="default">Here's what you need to complete your bank transfer.</p>
  </PageHeader>
  <BankTransferConfirmation client:load bookingNumber={bookingNumber} />
</MainLayout>
