---
import MainLayout from '../../layouts/MainLayout.astro';
import ProductDetail from '../../components/react/ProductDetail.jsx';
import { getProduct, getProducts, getProductReviews } from '../../lib/api';
import '../../styles/ProductDetail.css';

// Rendered on-demand so any product — including ones added in the admin after
// this deploy — gets a working page (server-rendered for SEO, no redeploy needed).
export const prerender = false;

const SITE_URL = 'https://www.climbcruxpakistan.com';
const { id } = Astro.params;

// Fetch full product data, all products, and reviews on each request
const product = await getProduct(id).catch(() => null);
const allProducts = await getProducts().catch(() => []);
const reviewData = await getProductReviews(id).catch(() => ({ reviews: [], total: 0, avgRating: 0, distribution: [0,0,0,0,0] }));

// Rich-text descriptions may contain HTML — strip it for the meta description.
const stripHtml = (html) => (html || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
const productName = product?.name;

// Use the SEO title/meta description set in the admin when provided,
// otherwise fall back to clean auto-generated values.
const pageTitle = product?.seo?.title?.trim()
  || (productName ? `${productName} — Climb Crux Pakistan` : 'Product — Climb Crux Pakistan');
const pageDescription = product?.seo?.metaDescription?.trim()
  || (productName ? (stripHtml(product.description).slice(0, 155) || `${productName} — climbing equipment from Climb Crux Pakistan, delivered across Pakistan.`) : '');

// Build JSON-LD for server-side rendering (visible to search engines)
let jsonLd = null;
if (product) {
  jsonLd = {
    '@context': 'https://schema.org/',
    '@type': 'Product',
    name: product.name,
    description: product.description ? stripHtml(product.description).slice(0, 300) : `${product.name} from Climb Crux Pakistan`,
    sku: product.sku || undefined,
    category: product.category || undefined,
    image: [product.imageUrl, ...(product.images || [])].filter(Boolean),
    offers: {
      '@type': 'Offer',
      url: `${SITE_URL}/shop/${id}`,
      priceCurrency: 'PKR',
      price: product.price,
      availability: product.inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      priceValidUntil: new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
    },
    ...(reviewData.total > 0 ? {
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: reviewData.avgRating,
        reviewCount: reviewData.total,
      },
    } : {}),
    ...(product.shipping?.deliveryTime ? {
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'PK' },
        deliveryTime: product.shipping.deliveryTime,
      },
    } : {}),
  }
}

// Breadcrumbs: Home › Shop › Product — helps Google understand site structure.
const breadcrumbJsonLd = product ? {
  '@context': 'https://schema.org/',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Climbing Gear & Equipment', item: `${SITE_URL}/shop/` },
    { '@type': 'ListItem', position: 3, name: product.name, item: `${SITE_URL}/shop/${id}` },
  ],
} : null;
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  image={product?.imageUrl || product?.images?.[0] || undefined}
  canonicalUrl={product?.seo?.canonicalUrl?.trim() || undefined}
>
  <Fragment slot="head">
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />
      )
    }
    {
      breadcrumbJsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
      )
    }
  </Fragment>
  {/* Product content rendered by React island using initial data — no loading spinner */}
  {
    !product && (
      <section class="section"><div class="wrap" style="text-align:center;padding:60px 20px;">
        <h2>Product not found</h2>
        <a href="/shop" class="btn btn-outline" style="margin-top:16px;">← Back to shop</a>
      </div></section>
    )
  }

  {/* React island for interactivity: uses initialProduct data to render immediately without loading state */}
  <ProductDetail
    client:only="react"
    id={id}
    initialProduct={JSON.stringify(product)}
    initialAllProducts={JSON.stringify(allProducts)}
    initialReviewData={JSON.stringify(reviewData)}
  />
</MainLayout>
