---
import MainLayout from '../../layouts/MainLayout.astro';
import ShopAnnouncementBar from '../../components/astro/ShopAnnouncementBar.astro';
import ProductDetail from '../../components/react/ProductDetail.jsx';
import { getProduct, getProducts, getProductReviews } from '../../lib/api';
import '../../styles/ProductDetail.css';

// Rendered on-demand so any product — including ones added in the admin after
// this deploy — gets a working page (server-rendered for SEO, no redeploy needed).
export const prerender = false;

const SITE_URL = 'https://www.climbcruxpakistan.com';
const { id } = Astro.params;

// Fetch full product data, all products, and reviews on each request
const product = await getProduct(id).catch(() => null);
const allProducts = await getProducts().catch(() => []);
const reviewData = await getProductReviews(id).catch(() => ({ reviews: [], total: 0, avgRating: 0, distribution: [0,0,0,0,0] }));

// An unknown id is a 404, not an indexable page: the response status is set
// here, the layout drops the canonical and marks the page `noindex, follow`,
// and the not-found copy is rendered by this page rather than by an island, so
// it does not depend on JavaScript.
const notFound = !product;
if (notFound) {
  Astro.response.status = 404;
  // Astro rewrites 404 responses to the /404 page by default; this directive
  // (Astro's REROUTE_DIRECTIVE_HEADER) keeps this page's own "Product not found"
  // body instead. If it were ever ignored, the site-wide /404 page renders
  // instead — still a real 404, still noindex, still no canonical.
  Astro.response.headers.set('X-Astro-Reroute', 'no');
}

// Rich-text descriptions may contain HTML — strip it for the meta description.
const stripHtml = (html) => (html || '').replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
const productName = product?.name;

// Two catalogue records can share a name (the shop currently has two
// "Carabiner - G View" listings), which used to produce byte-identical titles
// and meta descriptions for two different pages. When the generated title would
// collide, disambiguate it with an attribute the listings genuinely differ by —
// the colour the shop records in `features` ("Color: Silver"), otherwise the
// SKU, otherwise the first variant. Admin SEO values always win over this.
const liveProducts = allProducts.filter((p) => p.status !== 'draft' && p.status !== 'archived');
function distinguishingAttribute(p) {
  const colour = (p.features || []).map(String).find((f) => /^color\s*:/i.test(f));
  if (colour) return colour.split(':').slice(1).join(':').trim();
  if (p.sku) return p.sku;
  const variant = (p.variants || [])[0];
  if (variant) return [variant.name, variant.value].filter(Boolean).join(' ').trim();
  return '';
}
const nameCollides = !!product && liveProducts.some((p) => (p.id || p._id) !== id && p.name === product.name);
const disambiguator = nameCollides ? distinguishingAttribute(product) : '';
const displayName = productName && disambiguator ? `${productName} (${disambiguator})` : productName;

// Use the SEO title/meta description set in the admin when provided,
// otherwise fall back to clean auto-generated values.
const pageTitle = product?.seo?.title?.trim()
  || (displayName ? `${displayName} — Climb Crux Pakistan` : 'Product not found — Climb Crux Pakistan');
const pageDescription = product?.seo?.metaDescription?.trim()
  || (displayName ? (stripHtml(product.description).slice(0, 155) || `${displayName} — climbing equipment from Climb Crux Pakistan, delivered across Pakistan.`) : '');

// Build JSON-LD for server-side rendering (visible to search engines)
let jsonLd = null;
if (product) {
  jsonLd = {
    '@context': 'https://schema.org/',
    '@type': 'Product',
    name: product.name,
    description: product.description ? stripHtml(product.description).slice(0, 300) : `${product.name} from Climb Crux Pakistan`,
    sku: product.sku || undefined,
    category: product.category || undefined,
    image: [product.imageUrl, ...(product.images || [])].filter(Boolean),
    offers: {
      '@type': 'Offer',
      url: `${SITE_URL}/shop/${id}/`,
      priceCurrency: 'PKR',
      price: product.price,
      availability: product.inStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      priceValidUntil: new Date(Date.now() + 365 * 24 * 60 * 60 * 1000).toISOString().split('T')[0],
    },
    ...(reviewData.total > 0 ? {
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: reviewData.avgRating,
        reviewCount: reviewData.total,
      },
    } : {}),
    ...(product.shipping?.deliveryTime ? {
      shippingDetails: {
        '@type': 'OfferShippingDetails',
        shippingDestination: { '@type': 'DefinedRegion', addressCountry: 'PK' },
        deliveryTime: product.shipping.deliveryTime,
      },
    } : {}),
  }
}

// Breadcrumbs: Home › Shop › Product — helps Google understand site structure.
const breadcrumbJsonLd = product ? {
  '@context': 'https://schema.org/',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Climbing Gear & Equipment', item: `${SITE_URL}/shop/` },
    { '@type': 'ListItem', position: 3, name: product.name, item: `${SITE_URL}/shop/${id}/` },
  ],
} : null;
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  image={product?.imageUrl || product?.images?.[0] || undefined}
  canonicalUrl={product?.seo?.canonicalUrl?.trim() || undefined}
  noindex={notFound}
  robots={notFound ? 'noindex, follow' : undefined}
  noCanonical={notFound}
>
  <Fragment slot="head">
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />
      )
    }
    {
      breadcrumbJsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
      )
    }
  </Fragment>
  <ShopAnnouncementBar />
  {/* Server-rendered not-found state for an unknown product id (the response is
      a 404 and no island is mounted, so no JavaScript is needed to see this). */}
  {
    notFound && (
      <section class="section"><div class="wrap" style="text-align:center;padding:60px 20px;">
        <h2>Product not found</h2>
        <p style="color:var(--stone-dark);max-width:46ch;margin:8px auto 24px;">
          This product doesn't exist or is no longer available. Browse the shop to find the gear you need.
        </p>
        <a href="/shop/" class="btn btn-outline">← Back to shop</a>
      </div></section>
    )
  }

  {/* React island: `client:load` server-renders the product (name, price, description,
      specs, reviews) into the initial HTML so crawlers see real content, then hydrates
      for interactivity. `client:only` would ship an empty body. */}
  {product && (
    <ProductDetail
      client:load
      id={id}
      initialProduct={JSON.stringify(product)}
      initialAllProducts={JSON.stringify(allProducts)}
      initialReviewData={JSON.stringify(reviewData)}
    />
  )}
</MainLayout>
