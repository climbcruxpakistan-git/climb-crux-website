---
import MainLayout from '../../layouts/MainLayout.astro';
import Shop from '../../components/react/Shop.jsx';
import { getProducts, optimizeImage } from '../../lib/api';
import '../../styles/Shop.css';

// Rendered on-demand so the ItemList structured data always reflects the current
// product catalogue — anything added in the admin shows up immediately, no redeploy.
export const prerender = false;

const SITE_URL = 'https://www.climbcruxpakistan.com';
const products = await getProducts().catch(() => []);
const liveProducts = products.filter((p) => p.status !== 'draft' && p.status !== 'archived');
const categories = [...new Set(liveProducts.map((p) => p.category).filter(Boolean))];

const WHATSAPP_URL = 'https://wa.me/923350044403';
const WHATSAPP_TEXT = encodeURIComponent('Hi Climb Crux! I need help choosing climbing gear.');
const bannerProduct = liveProducts.find((p) => p.featured && (p.imageUrl || p.images?.[0])) || liveProducts.find((p) => p.imageUrl || p.images?.[0]);
const bannerImage = bannerProduct ? optimizeImage(bannerProduct.imageUrl || bannerProduct.images?.[0], 900) : '';
const bannerAlt = bannerProduct?.featuredImageAlt || bannerProduct?.name || 'Climbing gear from Climb Crux';

const initialParams = {
  q: Astro.url.searchParams.get('q') || '',
  cat: Astro.url.searchParams.get('cat') || '',
  sort: Astro.url.searchParams.get('sort') || '',
  brand: Astro.url.searchParams.get('brand') || '',
  cert: Astro.url.searchParams.get('cert') || '',
  stock: Astro.url.searchParams.get('stock') || '',
  saved: Astro.url.searchParams.get('saved') || '',
  min: Astro.url.searchParams.get('min') || '',
  max: Astro.url.searchParams.get('max') || '',
};

// ItemList structured data: tells Google this page represents the whole catalogue,
// so the equipment page can rank for individual product searches too.
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Climbing Equipment & Gear — Climb Crux Pakistan',
  description: 'Climbing equipment and gear from Climb Crux Pakistan — harnesses, helmets, ropes, carabiners, belay devices, climbing shoes and more, delivered across Pakistan.',
  numberOfItems: liveProducts.length,
  itemListElement: liveProducts.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.name,
    url: `${SITE_URL}/shop/${p.id}/`,
    image: p.imageUrl || undefined,
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Climbing Gear & Equipment', item: `${SITE_URL}/shop/` },
  ],
};
---

<MainLayout
  title="Climbing Gear & Equipment in Pakistan | Climb Crux"
  description="Buy climbing gear in Pakistan — harnesses, helmets, ropes, carabiners, climbing shoes and more. Curated climbing equipment from Climb Crux, delivered across Pakistan."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <section class="sp-banner">
    <div class="wrap sp-banner-inner">
      <div class="sp-banner-copy">
        <span class="sp-eyebrow">Climb Crux equipment</span>
        <h1>Gear up<span class="sp-dot">.</span></h1>
        <p>Curated climbing equipment for the Margalla Hills — harnesses, helmets, ropes and the hardware that keeps every move safe.</p>
        <div class="sp-banner-actions">
          <a class="btn btn-primary" href="#shop-catalogue">Shop the range</a>
          <a class="btn btn-outline sp-banner-wa" href={`${WHATSAPP_URL}?text=${WHATSAPP_TEXT}`} target="_blank" rel="noreferrer">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2zm0 18.15c-1.53 0-3.03-.41-4.34-1.19l-.31-.18-3.12.82.83-3.04-.2-.32a8.19 8.19 0 0 1-1.26-4.33c0-4.54 3.7-8.23 8.24-8.23 4.54 0 8.23 3.69 8.23 8.23s-3.69 8.24-8.07 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.25 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29z" />
            </svg>
            Ask on WhatsApp
          </a>
        </div>
        <ul class="sp-banner-points">
          <li>Safety-rated gear</li>
          <li>Nationwide delivery</li>
          <li>Climber-to-climber advice</li>
        </ul>
      </div>
      <div class="sp-banner-media">
        <div class="sp-banner-frame">
          {bannerImage ? (
            <img src={bannerImage} alt={bannerAlt} fetchpriority="high" />
          ) : (
            <span class="sp-banner-placeholder">CRUX</span>
          )}
        </div>
        <div class="sp-banner-tag">
          <span>Field-tested</span>
          <strong>Margalla ready</strong>
        </div>
      </div>
    </div>
  </section>

  <div id="shop-catalogue">
    <Shop client:load initial={liveProducts} initialParams={initialParams} />
  </div>

  <section class="section shop-seo-section">
    <div class="wrap">
      <h2>Climbing equipment in Pakistan</h2>
      <div class="shop-seo-copy">
        <p>Climb Crux stocks the climbing gear that keeps you safe on the wall — harnesses, helmets, ropes, carabiners, belay devices, climbing shoes and more. Every piece is selected for the limestone crags of Margalla Hills and delivered across Pakistan, with all safety hardware meeting climbing safety standards.</p>
      </div>
      {categories.length > 0 && (
        <nav class="shop-seo-categories" aria-label="Equipment categories">
          {categories.map((cat) => (
            <a key={cat} class="shop-seo-cat-link" href={`/shop/?cat=${encodeURIComponent(cat)}`}>{cat}</a>
          ))}
        </nav>
      )}
    </div>
  </section>
</MainLayout>
