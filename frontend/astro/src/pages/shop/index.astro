---
import MainLayout from '../../layouts/MainLayout.astro';
import PageHeader from '../../components/astro/PageHeader.astro';
import Shop from '../../components/react/Shop.jsx';
import '../../styles/Shop.css';
---

<MainLayout>
  <Fragment slot="head">
    <title>Climbing Gear Shop — Climb Crux Pakistan</title>
    <meta name="description" content="Shop curated climbing equipment for Margalla Hills. Harnesses, climbing shoes, hardware, and gear from trusted brands with delivery across Pakistan." />
  </Fragment>
  <PageHeader title="Gear up.">
    <p slot="default">Curated climbing equipment for the Margalla Hills — from harnesses and hardware to the shoes that stick the slab.</p>
  </PageHeader>
  <Shop client:load />
</MainLayout>
