---
import MainLayout from '../../layouts/MainLayout.astro';
import PageHeader from '../../components/astro/PageHeader.astro';
import Shop from '../../components/react/Shop.jsx';
import { getProducts } from '../../lib/api';
import { categorySlug } from '../../lib/shopCategories';
import '../../styles/Shop.css';

// Rendered on-demand so the ItemList structured data always reflects the current
// product catalogue — anything added in the admin shows up immediately, no redeploy.
export const prerender = false;

const SITE_URL = 'https://www.climbcruxpakistan.com';
const products = await getProducts().catch(() => []);
const liveProducts = products.filter((p) => p.status !== 'draft' && p.status !== 'archived');
const categories = [...new Set(liveProducts.map((p) => p.category).filter(Boolean))];

const initialParams = {
  q: Astro.url.searchParams.get('q') || '',
  cat: Astro.url.searchParams.get('cat') || '',
  sort: Astro.url.searchParams.get('sort') || '',
  brand: Astro.url.searchParams.get('brand') || '',
  cert: Astro.url.searchParams.get('cert') || '',
  stock: Astro.url.searchParams.get('stock') || '',
  saved: Astro.url.searchParams.get('saved') || '',
  min: Astro.url.searchParams.get('min') || '',
  max: Astro.url.searchParams.get('max') || '',
};

// ItemList structured data: tells Google this page represents the whole catalogue,
// so the equipment page can rank for individual product searches too.
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Climbing Equipment & Gear — Climb Crux Pakistan',
  description: 'Climbing equipment and gear from Climb Crux Pakistan — harnesses, helmets, ropes, carabiners, belay devices, climbing shoes and more, delivered across Pakistan.',
  numberOfItems: liveProducts.length,
  itemListElement: liveProducts.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: p.name,
    url: `${SITE_URL}/shop/${p.id}/`,
    image: p.imageUrl || undefined,
  })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Climbing Gear & Equipment', item: `${SITE_URL}/shop/` },
  ],
};
---

<MainLayout
  title="Rock Climbing Equipment & Climbing Gear in Pakistan | Climb Crux"
  description="Shop rock climbing equipment in Pakistan at Climb Crux. Explore climbing harnesses, carabiners, helmets, quickdraws, belay devices and other essential climbing gear."
  keywords="rock climbing equipment, climbing equipment, climbing gear, buy climbing equipment, climbing equipment Pakistan, carabiners, climbing harnesses, helmets, quickdraws, belay devices, climbing ropes, climbing helmets"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <PageHeader title="Rock Climbing Equipment & Climbing Gear" compact>
    <p>Harnesses, helmets, ropes, carabiners and the hardware that keeps every move safe — delivered across Pakistan.</p>
  </PageHeader>

  <div id="shop-catalogue">
    <Shop client:load initial={liveProducts} initialParams={initialParams} />
  </div>

  <section class="section shop-seo-section">
    <div class="wrap">
      <h2>Climbing equipment in Pakistan</h2>
      <div class="shop-seo-copy">
        <p>
          Use the filter to browse the whole catalogue, or jump straight to a category —
          each has its own page: <a href="/shop/category/carabiners/">carabiners</a>,
          <a href="/shop/category/harness/">climbing harnesses</a>,
          <a href="/shop/category/ropes/">climbing ropes</a>,
          <a href="/shop/category/helmets/"> helmets</a>,
          <a href="/shop/category/quick-draws/">quickdraws</a> and
          <a href="/shop/category/belaying-devices/">belay devices</a>.
        </p>
      </div>
      {categories.length > 0 && (
        <nav class="shop-seo-categories" aria-label="Equipment categories">
          {categories.map((cat) => (
            <a key={cat} class="shop-seo-cat-link" href={`/shop/category/${categorySlug(cat)}/`}>{cat}</a>
          ))}
        </nav>
      )}
    </div>
  </section>
</MainLayout>
