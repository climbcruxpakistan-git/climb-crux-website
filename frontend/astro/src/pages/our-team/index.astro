---
import MainLayout from '../../layouts/MainLayout.astro';
import TeamContent from '../../components/react/TeamContent.jsx';
import { getTeam } from '../../lib/api';
import '../../styles/OurTeam.css';

const instructors = await getTeam().catch(() => []);
---

<MainLayout>
  <Fragment slot="head">
    <title>Our Team — Climb Crux Pakistan</title>
    <meta name="description" content="Meet the certified climbing instructors at Climb Crux Pakistan. Experienced guides holding your rope on Margalla Hills, Islamabad." />
  </Fragment>

  <TeamContent client:load initial={instructors} />
</MainLayout>
