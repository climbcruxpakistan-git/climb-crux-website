---
import MainLayout from '../../layouts/MainLayout.astro';
import TeamContent from '../../components/react/TeamContent.jsx';
import { getTeam } from '../../lib/api';
import '../../styles/OurTeam.css';

const instructors = await getTeam().catch(() => []);
---

<MainLayout
  title="Our Team — Climb Crux Pakistan"
  description="Meet the certified climbing instructors at Climb Crux Pakistan. Experienced guides holding your rope on Margalla Hills, Islamabad."
>

  <TeamContent client:load initial={instructors} />
</MainLayout>
