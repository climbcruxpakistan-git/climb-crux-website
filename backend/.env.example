# MongoDB
MONGODB_URI=mongodb://localhost:27017/climb-crux

# Server
PORT=4000
# http://localhost:5173 for local dev
# https://climb-crux-frontend.vercel.app for production
FRONTEND_URL=https://climb-crux-frontend.vercel.app

# Auth (JWT)
JWT_SECRET=change-this-to-a-random-string

# Resend (transactional email)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# EMAIL_FROM="Climb Crux <bookings@climbcruxpakistan.com>"
# CLIMB_CRUX_WHATSAPP=+923132690377
# NOTIFICATION_EMAIL=admin@example.com

# DNS servers (optional, comma-separated)
# DNS_SERVERS=8.8.8.8,1.1.1.1
